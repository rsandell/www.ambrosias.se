#!/usr/bin/env python3
"""Konverterar de gamla klädkodssidorna (HTML) till Markdown under content/klädkod/.

Användning (från repots rot):
    python3 migration/scripts/convert_pages [källmapp] [målmapp]
Standard: migration/live-views/views/dresscode  ->  content/klädkod

Texten skrivs inte om. Bara formatet städas (entiteter, &nbsp;, länkar).
Skriptet skriver också en rapport: ord före och efter måste vara identiska.
"""
import os
import re
import sys
import html as htmllib

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import htmlmd

SRC = sys.argv[1] if len(sys.argv) > 1 else "migration/live-views/views/dresscode"
DST = sys.argv[2] if len(sys.argv) > 2 else "content/klädkod"

TITLES = {  # fallback om sidan saknar <h1>
}


def fixlink(href):
    """Gamla länkar (#/dresscode/x, x.php) -> Hugos adresser. Externa länkar lämnas."""
    m = re.match(r"^#/dresscode/?([a-z0-9]*)$", href)
    if m:
        return "/klädkod/" + (m.group(1) + "/" if m.group(1) else "")
    m = re.match(r"^([a-z0-9]+)\.php$", href)
    if m:
        return "/klädkod/" + m.group(1) + "/"
    return href


def squash(words):
    """Jämför utan mellanslag (länkar kan flytta mellanrum kring skiljetecken)."""
    return "".join(words)


def words_of_source(raw):
    t = re.sub(r"<\?.*?\?>|<!DOCTYPE[^>]*>", " ", raw)
    t = re.sub(r"<[^>]+>", " ", t)
    return htmlmd.norm_ws(htmllib.unescape(t)).split()


def words_of_md(md):
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", md)      # länkar -> text
    t = t.replace("\\\n", " ").replace("{.kalla}", " ")
    t = re.sub(r"(?m)^(?:\d+\.|-) ", "", t)                   # listmarkörer
    t = re.sub(r"[*#]", " ", t)
    return htmlmd.norm_ws(t).split()


def convert(name, raw):
    blocks = htmlmd.parse(raw, fixlink)
    title = None
    body = []
    for b in blocks:
        if b[0] == "h" and title is None and (b[1] == 1 or not body):   # saknas h1 används första rubriken
            title = htmlmd.inline_one(b[2])
            continue
        if b[0] == "h":
            body.append("#" * b[1] + " " + htmlmd.inline_one(b[2]).replace("\\\n", " "))
        elif b[0] == "p":
            text = htmlmd.inline_one(b[1])
            if not text:
                continue
            if text.startswith("Källa:") or text.startswith("Källa:"):
                text += "\n{.kalla}"
            body.append(text)
        elif b[0] == "list":
            items = [htmlmd.inline_one(i) for i in b[2]]
            if b[1] == "ol":
                body.append("\n".join("%d. %s" % (n + 1, t) for n, t in enumerate(items) if t))
            else:
                body.append("\n".join("- " + t for t in items if t))
    fallback = title is None
    title = title or name.capitalize()
    return title, "\n\n".join(body) + "\n", fallback


def main():
    os.makedirs(DST, exist_ok=True)
    ok = True
    for fn in sorted(os.listdir(SRC)):
        if not fn.endswith(".html"):
            continue
        name = fn[:-5]
        data = open(os.path.join(SRC, fn), "rb").read()
        try:
            raw = data.decode("utf-8")
        except UnicodeDecodeError:       # aftonklanning.html är Windows-1252
            raw = data.decode("cp1252")
        title, md, fallback = convert(name, raw)
        is_index = name == "index"
        front = "---\ntitle: \"%s\"\n" % title.replace('"', '\\"')
        if not is_index:
            front += "slug: \"%s\"\n" % name
            front += "legacy_page: \"%s\"\n" % name
        front += "---\n\n"
        out = os.path.join(DST, "_index.md" if is_index else name + ".md")
        with open(out, "w", encoding="utf-8") as f:
            f.write(front + md)
        before = words_of_source(raw)
        after = words_of_md(("" if fallback else title + "\n") + md)
        same = squash(before) == squash(after)
        ok &= same
        print("%-24s %4d ord  %s" % (fn, len(before), "OK" if same else "SKILLNAD"))
        if not same:
            import difflib
            for l in difflib.unified_diff(before, after, "före", "efter", lineterm="", n=2):
                print("   ", l)
    sys.exit(0 if ok else 1)


main()
